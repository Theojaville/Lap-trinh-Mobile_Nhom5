# ============================================================
# .gitignore — ProsumerChat
# ============================================================

# ── Android / Gradle ─────────────────────────────────────────
*.iml
.gradle/
/local.properties
/.idea/caches/
/.idea/libraries/
/.idea/modules.xml
/.idea/workspace.xml
/.idea/navEditor.xml
/.idea/assetWizardSettings.xml
.DS_Store
/build/
/captures/
.externalNativeBuild/
.cxx/

# Module-level build output
app/build/

# ── SECURITY — Firebase config (mỗi dev tự tải về máy mình) ─
# KHÔNG BAO GIỜ commit file này lên git!
# Tải tại: Firebase Console → Project Settings → Download google-services.json
# Đặt tại: app/google-services.json
app/google-services.json
google-services.json

# ── SECURITY — Keystore & signing configs ────────────────────
*.jks
*.keystore
keystore.properties
signing.properties

# ── IDE — Android Studio / IntelliJ ─────────────────────────
*.class
*.bak
*.tmp
*.orig
*.swp
out/

# ── OS ───────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
