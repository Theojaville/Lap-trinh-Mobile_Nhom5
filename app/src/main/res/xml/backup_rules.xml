<?xml version="1.0" encoding="utf-8"?>
<!--
    backup_rules.xml — Quy tắc Auto Backup cho Android <= 11 (API <= 30).
    Loại trừ hoàn toàn Tink keyset, dữ liệu bảo mật và SQLCipher DB khỏi cloud backup
    vì khóa Android Keystore gắn liền phần cứng thiết bị gốc.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="prosumerchat_keyset_prefs.xml" />
    <exclude domain="sharedpref" path="prosumerchat_secure_prefs.xml" />
    <exclude domain="database" path="prosumerchat.db" />
    <exclude domain="database" path="prosumerchat.db-wal" />
    <exclude domain="database" path="prosumerchat.db-shm" />
    <exclude domain="database" path="prosumerchat.db-journal" />
</full-backup-content>
