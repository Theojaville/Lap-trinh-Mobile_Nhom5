<?xml version="1.0" encoding="utf-8"?>
<!--
    styles.xml — Shared Material 3 component styles for ProsumerChat.
-->
<resources>
    <!-- ── TextInputLayout (Outlined M3) ───────────────────────── -->
    <style name="Widget.ProsumerChat.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="errorEnabled">true</item>
    </style>

    <!-- ── Buttons (M3 Filled, Outlined, Text) ─────────────────── -->
    <style name="Widget.ProsumerChat.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.ProsumerChat.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.ProsumerChat.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ── Toolbar (M3 Surface) ────────────────────────────────── -->
    <style name="Widget.ProsumerChat.Toolbar" parent="Widget.Material3.Toolbar.Surface">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextAppearance">?attr/textAppearanceTitleLarge</item>
    </style>

    <!-- ── Outlined Card (M3) ──────────────────────────────────── -->
    <style name="Widget.ProsumerChat.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
    </style>

    <!-- ── Section Header (Profile / Settings) ─────────────────── -->
    <style name="TextAppearance.ProsumerChat.SectionHeader" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- ── ShapeAppearance (Circular Avatar) ───────────────────── -->
    <style name="ShapeAppearance.ProsumerChat.Circle" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
